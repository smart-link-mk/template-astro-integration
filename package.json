  },
  "publishConfig": {
    "provenance": false
  },
  "dependencies": {
    "@smart-link-mk/api-client-sdk": "^0.0.1",
    "adm-zip": "^0.5.16",
    "json-schema-to-typescript": "^15.0.4",
    "liquidjs": "^10.21.0",
    "lodash.set": "^4.3.2",
    "walkjs": "^6.0.1"
