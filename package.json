{
  "name": "@smart-link-mk/template-astro-integration",
  "description": "Use Astro to build a Smart-Link template",
  "version": "1.0.0",
  "type": "module",
  "author": "Muamet Islami",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-link-mk/template-astro-integration.git"
  },
  "keywords": [
    "astro-integration",
    "smart-link",
    "template"
  ],
  "bugs": "https://github.com/smart-link-mk/template-astro-integration/issues",
  "homepage": "https://smartlink.mk",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./package.json": "./package.json"
